# Variables publiques cote client, pour `npm run dev` (copier en .env.local).
# Le build de production lit .env.supabase (commite).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here
# Mode hors ligne (PowerSync). Laisser vide pour le desactiver : le reste de
# l'app fonctionne normalement en ligne.
VITE_POWERSYNC_URL=
# Observabilite client (optionnel) - laisser vide pour desactiver Sentry
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES=0
